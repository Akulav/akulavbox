    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.8",
    "jsonwebtoken": "^9.0.3",
    "vue": "^3.5.13",
    "yauzl": "^3.4.0"
  },
  "optionalDependencies": {
    "bcrypt": "^6.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7"
  },
