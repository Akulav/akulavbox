PORT=3000

# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=change-me

# AES-256 key for file encryption at rest. Must be exactly 32 characters.
# Changing it later makes existing files unreadable.
MASTER_KEY=change-me-to-exactly-32-chars!!!

# Optional: info logs every request (default: warn)
# LOG_LEVEL=info

# Optional: where data lives (default: ./data in the app folder; DATA_DIR works too)
# STORAGE_DIR=/srv/akulavbox
# HOST=0.0.0.0

# Optional: days deleted items stay in the trash (default 30)
# TRASH_DAYS=30
# Optional: uploads stop when the disk would have less than this free (MB, default 512)
# DISK_RESERVE_MB=512
# Optional: how long a sign-in lasts without use (default 7d; active sessions renew daily)
# TOKEN_TTL=7d
# Optional: set to 1 behind a reverse proxy so rate limiting sees real client IPs
# TRUST_PROXY=1
# Optional: other websites allowed to call the API from a browser (default: none, the app is same-origin)
# CORS_ORIGIN=https://app.example.com
# Optional: set to 0 if storage is on a network drive (turns off SQLite WAL mode)
# SQLITE_WAL=1

# Optional: link downloads (YouTube etc.). yt-dlp and ffmpeg install themselves into data/tools.
# DOWNLOADS=off             # turn the feature off
# AUTO_INSTALL_TOOLS=0      # don't install tools; use YTDLP_PATH / FFMPEG_PATH or copies on PATH
# YTDLP_PATH=
# FFMPEG_PATH=
# VIDEO_AV1=off             # keep downloaded video as served instead of AV1
# DOWNLOAD_PARALLEL=3
# ENCODE_BACKLOG=4          # downloaded videos that may wait for the AV1 encoder without holding a download slot
# DOWNLOAD_STALL_SECONDS=180 # stop (and retry) a download that receives nothing for this long
# DOWNLOAD_PLAYLIST_MAX=200
# DOWNLOAD_PROXY=socks5://127.0.0.1:1080   # for sites blocked where the server is

# Optional: passphrase for scheduled backups (Admin → Backup and restore). Set here, it is
# never stored in the database; otherwise the one typed in Admin is saved, sealed with MASTER_KEY.
# BACKUP_PASSPHRASE=
# Optional: days the activity log (Admin → Activity) keeps entries (default 180)
# ACTIVITY_DAYS=180

# Optional: updates from GitHub (Admin → Updates)
# UPDATES=off               # turn update checks and installs off
# UPDATE_REPO=Akulav/akulavbox
# UPDATE_BRANCH=main
# GITHUB_TOKEN=             # only for a private fork

