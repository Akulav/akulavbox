PORT=3000

# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=change-me

# AES-256 key for file encryption at rest. Must be exactly 32 characters.
# Changing it later makes existing files unreadable.
MASTER_KEY=change-me-to-exactly-32-chars!!!

# Optional: info logs every request (default: warn)
# LOG_LEVEL=info

# Optional: TURN relay for voice/video calls (needed behind strict NATs / hardened browsers)
# TURN_URLS=turn:your.host:3478,turns:your.host:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=
# TURN_SECRET=            # coturn static-auth-secret (short-lived credentials)
# CF_TURN_KEY_ID=         # Cloudflare Realtime TURN
# CF_TURN_API_TOKEN=
# STUN_URLS=stun:stun.cloudflare.com:3478
